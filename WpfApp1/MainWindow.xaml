<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="{Binding Market.GoldPrice, StringFormat='K18相場: {0}'}" Margin="0,0,20,0"/>
            <TextBlock Text="{Binding Market.PlaPrice, StringFormat='Pt850相場: {0}'}"/>
        </StackPanel>
        
        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLines}"
                  AutoGenerateColumns="False"
                  Margin="10"
                  HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="商品名" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="価格" Binding="{Binding Price}" Width="*"/>
                <DataGridTextColumn Header="相場" Binding="{Binding MarketPrice}" Width="*"/>
                <DataGridTextColumn Header="差額" Binding="{Binding OverPayment}" Width="*"/>
                <DataGridTextColumn Header="判定" Binding="{Binding Judgement}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
